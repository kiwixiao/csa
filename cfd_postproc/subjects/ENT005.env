# ENT005 post-processing config (run_subject.sh). Corrected run: ENT005@165522.sim, export = 82 steps
# (files 106-187, t = 0.025-2.050 s). Mouth closed -> nasal regions only.
SUBJ=ENT005
ROOT=/storage4/ENT005
SUBJ_DIR=$ROOT/ENT005
CASE=$ROOT/CFD/ENT005_Case/ENT005.case
CSA=$SUBJ_DIR/csa_bifurcation/ENT005-Data.csv
PROF=$ROOT/CFD/profiles_from_sim/ENT005FlowProfile_fromSim.csv   # corrected sign (ENT005Flowprofile.csv is the old run's)
RHO=1.2090                         # fitted: profile mdot vs BronchiOut flux, R^2 0.999997
REGIONS="LeftNose RightNose DescendingAirway"
PATHS_ANAT="LeftNose RightNose"    # nostril -> trachea routes (each = nose region + DescendingAirway)
WOB_PATHS="LeftNose RightNose"
WOB_EXCLUDE=""
MAIN_PATH=LeftNose
VMAX=37                            # peak of per-frame p99.9 |v| over the breath (global max 43.4 m/s at t=1.70 s)
VEL_MAXDIM=400                     # 250 under-resolves the ~3 mm exhale jet throat
VELSCAN=$ROOT/postproc/velocity_scan/ENT005_velocity_scan.csv
FPS=12
POST=$ROOT/postproc
# upstream stages (csa / motioncheck): breath length for csa-bifurcation --stop, registration control-point CSV
BREATH_MS=2068
REG_CSV=$ROOT/ENT5_noalign_be0.001.csv
TABLES_DIR=$ROOT/CFD/Tables                # CFD motion tables (optional cross-check against REG_CSV)
# cleaned nostril end (clean_nostril_planes.py + clean_combined_planes.py, 2026-11-02):
# pocket planes off the centerline dropped, nostril opening (cap) added as s = 0
CSA_PLOT=$POST/csa_clean/ENT005-Data-clean.csv
PE_IN=$POST/csa_clean/csa_pe
PLANES_DIR=$POST/csa_clean/combined_planes
# regions for the work-of-breathing breakdown, mm from the MAIN_PATH nostril opening (nose = opening -> top of the
# shared airway, automatic). DRAFT boundaries from the CSA shape - to be confirmed by the user (2026-11-02)
WOB_REGIONS="pharynx:nose_end:150,larynx:150:195,trachea:195:end"
