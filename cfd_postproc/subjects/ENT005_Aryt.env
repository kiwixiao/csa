# ENT005 virtually edited geometry "Aryt" (larynx widened up to ~3 mm, 145-170 mm from the nostril): an
# independent CFD run (same breath and boundary conditions, export ENT005_Case_Aryt, 82 steps t = 0.025-2.050 s),
# processed exactly like ENT005. Same CSA planes / centerline as ENT005, so distances match the native report.
# CSA = ENT005's cleaned table with the edited span re-cut: recut_csa.py on both CFD walls with the same planes,
# area x (Aryt / native) - prepared by hand like ENT005's csa_clean (see postproc_aryt/csa_clean/README).
source "$(dirname "${BASH_SOURCE[0]}")/ENT005.env"
SUBJ=ENT005_Aryt
CASE=$ROOT/CFD/ENT005_Case_Aryt/ENT005.case
POST=$ROOT/postproc_aryt
CSA_PLOT=$POST/csa_clean/ENT005-Data-clean.csv
PE_IN=$POST/csa_clean/csa_pe
RHO=1.2090                         # profile check fits 1.2096: same solver setup as ENT005
# velocity_breath_final/manifest.json copied from ENT005 (same sampling grid -> renders framed identically)
WOB_CMAX=6.894                     # ENT005's centerline WOB colour max (mW/mm): the two reports share one scale
